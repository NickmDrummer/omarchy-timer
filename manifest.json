{
  "schemaVersion": 1,
  "id": "nickmdrummer.timer",
  "name": "Looper: Timer, Pomodoro & Alarms",
  "version": "1.1.0",
  "author": "nickmdrummer",
  "license": "MIT",
  "description": "Time suite for the top bar: timer, pomodoro and alarms, with a countdown pill and an always-on-top floating card.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Looper",
    "description": "Timer, pomodoro and alarms in the bar.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sound": "On",
      "theme": "Original"
    },
    "schema": [
      {
        "key": "sound",
        "type": "enum",
        "label": "Alarm sound",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "theme",
        "type": "enum",
        "label": "Theme",
        "options": [
          "Original",
          "Omarchy"
        ],
        "defaultValue": "Original"
      }
    ]
  }
}
